@model Abstracciones.Modelos.Trabajador.Trabajador.TrabajadorRequest

@{
    ViewData["Title"] = "Agregar Trabajador";

    if (ViewBag.Modal == true)
    {
        Layout = "~/Views/Shared/_ModalLayout.cshtml";
    }

    bool isModal = ViewBag.Modal == true;
}

@if (ViewBag.ErrorApi != null)
{
    <div class="mf-error-banner">@ViewBag.ErrorApi</div>
}

<form asp-action="Crear" asp-route-modal="@isModal" method="post" class="modal-form">

    <div class="mf-group">
        <label asp-for="Cedula" class="mf-label">Cédula</label>
        <input asp-for="Cedula" class="mf-input" />
        <span asp-validation-for="Cedula" class="mf-error"></span>
    </div>

    <div class="mf-group">
        <label asp-for="Nombre_Completo" class="mf-label">Nombre Completo</label>
        <input asp-for="Nombre_Completo" class="mf-input" />
        <span asp-validation-for="Nombre_Completo" class="mf-error"></span>
    </div>

    <div class="mf-group">
        <label asp-for="Id_Puesto" class="mf-label">Puesto</label>
        <select asp-for="Id_Puesto" asp-items="ViewBag.Puestos" class="mf-select">
            <option value="">Seleccione un puesto</option>
        </select>
        <span asp-validation-for="Id_Puesto" class="mf-error"></span>
    </div>

    <div class="mf-group">
        <label asp-for="Fecha_Ingreso" class="mf-label">Fecha de ingreso <span style="font-weight:400;text-transform:none;">(opcional)</span></label>
        <input asp-for="Fecha_Ingreso" class="mf-input" type="date" />
        <span asp-validation-for="Fecha_Ingreso" class="mf-error"></span>
    </div>

    <div class="mf-actions">
        <button type="submit" class="mf-btn mf-btn-primary">Guardar</button>
        @if (!isModal)
        {
            <a asp-action="Index" class="mf-btn mf-btn-secondary">Volver</a>
        }
    </div>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
