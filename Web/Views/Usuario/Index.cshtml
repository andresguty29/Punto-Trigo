@model IEnumerable<Abstracciones.Modelos.Usuario.Usuario.UsuarioResponse>

<h1>Usuarios</h1>

<p>
    <a asp-action="Crear" class="btn btn-primary">
        Agregar Usuario
    </a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Nombre Usuario</th>
            <th>Id Trabajador</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var usuario in Model)
        {
            <tr>
                <td>@usuario.Nombre_Usuario</td>
                <td>@usuario.Id_Trabajador</td>
                <td>@usuario.Id_Estado</td>

                <td>
                    <a asp-action="Editar"
                       asp-route-id="@usuario.Id_Usuario"
                       class="btn btn-warning btn-sm">
                        Editar
                    </a>

                    <a asp-action="Eliminar"
                       asp-route-id="@usuario.Id_Usuario"
                       class="btn btn-danger btn-sm">
                        Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>