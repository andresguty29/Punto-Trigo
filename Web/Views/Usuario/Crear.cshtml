@model Abstracciones.Modelos.Usuario.Usuario.UsuarioRequest

<h1>Agregar Usuario</h1>

<form asp-action="Crear" method="post">

    <div class="mb-3">
        <label asp-for="Nombre_Usuario" class="form-label"></label>
        <input asp-for="Nombre_Usuario" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Contrasena" class="form-label"></label>
        <input asp-for="Contrasena"
               type="password"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Id_Trabajador" class="form-label">
            Trabajador
        </label>

        <select asp-for="Id_Trabajador"
                asp-items="ViewBag.Trabajadores"
                class="form-control">

            <option value="">
                Seleccione un trabajador
            </option>

        </select>
    </div>

    <button type="submit" class="btn btn-success">
        Guardar
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Volver
    </a>

</form>