@model Abstracciones.Modelos.Inventario.Inventario.InventarioRequest

@{
    ViewData["Title"] = "Agregar Item de Inventario";

    if (ViewBag.Modal == true)
    {
        Layout = "~/Views/Shared/_ModalLayout.cshtml";
    }

    bool isModal = ViewBag.Modal == true;
}

<form asp-action="Crear" asp-route-modal="@isModal" method="post" class="modal-form">

    <div class="mf-group">
        <label asp-for="Nombre" class="mf-label">Nombre</label>
        <input asp-for="Nombre" class="mf-input" placeholder="Ej: Harina de trigo" />
        <span asp-validation-for="Nombre" class="mf-error"></span>
    </div>

    <div class="mf-group">
        <label asp-for="Unidad" class="mf-label">Unidad de medida</label>
        <select asp-for="Unidad" class="mf-select">
            <option value="">Seleccione una unidad</option>
            <option value="kg">kg — Kilogramos</option>
            <option value="g">g — Gramos</option>
            <option value="L">L — Litros</option>
            <option value="ml">ml — Mililitros</option>
            <option value="unidades">Unidades</option>
            <option value="cajas">Cajas</option>
            <option value="bolsas">Bolsas</option>
        </select>
        <span asp-validation-for="Unidad" class="mf-error"></span>
    </div>

    <div class="mf-group">
        <label asp-for="Stock_Minimo" class="mf-label">Stock mínimo</label>
        <input asp-for="Stock_Minimo" class="mf-input" type="number" step="0.01" min="0" />
        <span asp-validation-for="Stock_Minimo" class="mf-error"></span>
    </div>

    <div class="mf-group">
        <label asp-for="Id_Proveedor" class="mf-label">Proveedor <span style="font-weight:400;text-transform:none;">(opcional)</span></label>
        <select asp-for="Id_Proveedor" asp-items="ViewBag.Proveedores" class="mf-select">
            <option value="">Sin proveedor</option>
        </select>
    </div>

    <div class="mf-actions">
        <button type="submit" class="mf-btn mf-btn-primary">Guardar</button>
        @if (!isModal)
        {
            <a asp-action="Index" class="mf-btn mf-btn-secondary">Volver</a>
        }
    </div>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
