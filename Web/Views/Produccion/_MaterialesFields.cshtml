@model List<Abstracciones.Modelos.Produccion.Produccion.MaterialAsignacionRequest>

<div class="mf-group">
    <label class="mf-label">Materiales necesarios</label>

    <div id="materialesRows">
        @for (int i = 0; i < Model.Count; i++)
        {
            <div class="material-row" style="display:flex; gap:8px; margin-bottom:8px; align-items:center;">
                <input type="hidden" name="Materiales.Index" value="@i" />
                <select name="Materiales[@i].Id_Inventario" class="mf-select" required>
                    <option value="">Seleccione un material</option>
                    @foreach (var item in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Inventario)
                    {
                        if (item.Value == Model[i].Id_Inventario.ToString())
                        {
                            <option value="@item.Value" selected>@item.Text</option>
                        }
                        else
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    }
                </select>
                <input type="number" name="Materiales[@i].Cantidad" class="mf-input" step="0.01" min="0.01" value="@Model[i].Cantidad" placeholder="Cantidad" required />
                <button type="button" class="mf-btn mf-btn-secondary btn-quitar-material">Quitar</button>
            </div>
        }
    </div>

    <button type="button" id="btnAgregarMaterial" class="mf-btn mf-btn-secondary">+ Agregar material</button>
</div>

<template id="materialRowTemplate">
    <div class="material-row" style="display:flex; gap:8px; margin-bottom:8px; align-items:center;">
        <input type="hidden" name="Materiales.Index" value="__INDEX__" />
        <select name="Materiales[__INDEX__].Id_Inventario" class="mf-select" required>
            <option value="">Seleccione un material</option>
            @foreach (var item in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Inventario)
            {
                <option value="@item.Value">@item.Text</option>
            }
        </select>
        <input type="number" name="Materiales[__INDEX__].Cantidad" class="mf-input" step="0.01" min="0.01" placeholder="Cantidad" required />
        <button type="button" class="mf-btn mf-btn-secondary btn-quitar-material">Quitar</button>
    </div>
</template>

<script>
    (function () {
        let materialIndex = @Model.Count;
        const rowsContainer = document.getElementById('materialesRows');
        const template = document.getElementById('materialRowTemplate');

        function bindQuitarButtons() {
            rowsContainer.querySelectorAll('.btn-quitar-material').forEach(function (btn) {
                btn.onclick = function () {
                    btn.closest('.material-row').remove();
                };
            });
        }

        document.getElementById('btnAgregarMaterial').addEventListener('click', function () {
            const html = template.innerHTML.replaceAll('__INDEX__', materialIndex);
            const wrapper = document.createElement('div');
            wrapper.innerHTML = html.trim();
            rowsContainer.appendChild(wrapper.firstElementChild);
            materialIndex++;
            bindQuitarButtons();
        });

        bindQuitarButtons();
    })();
</script>
