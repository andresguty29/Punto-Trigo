@model IEnumerable<Abstracciones.Modelos.Producto.Producto.ProductoResponse>

<h1>Productos</h1>

<p>
    <a asp-action="Crear" class="btn btn-primary">Agregar Producto</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Precio Venta</th>
            <th>Stock Actual</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var producto in Model)
        {
            <tr>
                <td>@producto.Nombre_Producto</td>
                <td>@producto.Precio_Venta</td>
                <td>@producto.Stock_Actual</td>
                <td>@producto.Estado</td>
                <td>
                    <a asp-action="Editar" asp-route-id="@producto.Id_Producto" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Eliminar" asp-route-id="@producto.Id_Producto" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>