@model Abstracciones.Modelos.Proveedor.Proveedor.ProveedorRequest

@{
    ViewData["Title"] = "Agregar Proveedor";

    if (ViewBag.Modal == true)
    {
        Layout = "~/Views/Shared/_ModalLayout.cshtml";
    }

    bool isModal = ViewBag.Modal == true;
}

<form asp-action="Crear" asp-route-modal="@isModal" method="post" class="modal-form">

    <div class="mf-group">
        <label asp-for="Nombre_Proveedor" class="mf-label">Nombre del Proveedor</label>
        <input asp-for="Nombre_Proveedor" class="mf-input" />
        <span asp-validation-for="Nombre_Proveedor" class="mf-error"></span>
    </div>

    <div class="mf-group">
        <label asp-for="Telefono_Proveedor" class="mf-label">Teléfono</label>
        <input asp-for="Telefono_Proveedor" class="mf-input" />
        <span asp-validation-for="Telefono_Proveedor" class="mf-error"></span>
    </div>

    <div class="mf-group">
        <label asp-for="Correo_Proveedor" class="mf-label">Correo Electrónico</label>
        <input asp-for="Correo_Proveedor" class="mf-input" type="email" />
        <span asp-validation-for="Correo_Proveedor" class="mf-error"></span>
    </div>

    <div class="mf-actions">
        <button type="submit" class="mf-btn mf-btn-primary">Guardar</button>
        @if (!isModal)
        {
            <a asp-action="Index" class="mf-btn mf-btn-secondary">Volver</a>
        }
    </div>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
