@model Abstracciones.Modelos.Proveedor.Proveedor.ProveedorRequest

<h1>Editar Proveedor</h1>

<form asp-action="Editar" method="post">

    <input type="hidden" asp-for="Id_Proveedor" />

    <div class="mb-3">
        <label asp-for="Nombre_Proveedor" class="form-label"></label>
        <input asp-for="Nombre_Proveedor" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Telefono_Proveedor" class="form-label"></label>
        <input asp-for="Telefono_Proveedor" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Correo_Proveedor" class="form-label"></label>
        <input asp-for="Correo_Proveedor" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">
        Guardar Cambios
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Volver
    </a>

</form>