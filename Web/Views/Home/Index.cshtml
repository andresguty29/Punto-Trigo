@using System.Text.Json
@model Web.Models.DashboardViewModel
@{
    Layout = null;
    var payload = JsonSerializer.Serialize(Model.Modules, new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    });
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Punto Trigo</title>
    <style>
            :root {
                --brand-primary: #0B3D6E;
                --brand-accent-red: #C41E1E;
                --brand-accent-gold: #D4920A;
                --brand-light: #FDF8F0;
                --brand-white: #FFFFFF;
                --brand-border: #E8E0D4;
                --ink-900: #1C2536;
                --ink-600: #5C6678;
                --ink-500: #6B7280;
            }

            *, *::before, *::after {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
                background: linear-gradient(135deg, #fdf8f0 0%, #f7f1e5 100%);
                color: var(--ink-900);
            }

            .page-shell {
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            .topbar {
                height: 58px;
                background: var(--brand-primary);
                color: white;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 24px;
                border-bottom: 3px solid var(--brand-accent-gold);
                box-shadow: 0 2px 14px rgba(0, 0, 0, .18);
            }

            .topbar-brand {
                display: flex;
                align-items: center;
                gap: 10px;
                font-weight: 800;
            }

            .topbar-subtitle {
                opacity: .75;
                font-weight: 500;
            }

            .topbar-right {
                display: flex;
                align-items: center;
                gap: 16px;
                font-size: .9rem;
            }

            .topbar-avatar {
                width: 34px;
                height: 34px;
                border-radius: 999px;
                background: var(--brand-accent-red);
                color: white;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-weight: 800;
                border: 2px solid var(--brand-accent-gold);
            }

            .workspace {
                flex: 1;
                display: flex;
                min-height: 0;
            }

            .sidebar {
                width: 220px;
                background: white;
                border-right: 1px solid var(--brand-border);
                padding: 14px 0;
                display: flex;
                flex-direction: column;
                gap: 4px;
                box-shadow: 2px 0 8px rgba(0,0,0,.03);
            }

            .sidebar-item {
                border: none;
                background: transparent;
                text-align: left;
                padding: 12px 18px;
                cursor: pointer;
                font-size: .92rem;
                color: var(--ink-500);
                font-weight: 600;
                border-left: 3px solid transparent;
            }

                .sidebar-item:hover {
                    background: var(--brand-light);
                    color: var(--ink-900);
                }

                .sidebar-item.active {
                    background: var(--brand-light);
                    color: var(--brand-primary);
                    border-left-color: var(--brand-accent-gold);
                }

            .module-view {
                flex: 1;
                overflow: auto;
                padding: 24px 28px;
                display: flex;
                flex-direction: column;
                gap: 18px;
            }

            .module-header {
                background: white;
                border-radius: 16px;
                padding: 24px 28px;
                display: flex;
                gap: 24px;
                justify-content: space-between;
                border-left: 5px solid var(--accent, var(--brand-primary));
                box-shadow: 0 4px 14px rgba(12, 23, 38, .08);
                border: 1px solid var(--brand-border);
            }

            .mh-left {
                flex: 1;
            }

            .mh-title {
                margin: 0 0 8px;
                font-size: 1.8rem;
                color: var(--brand-primary);
            }

            .mh-tag {
                display: inline-block;
                padding: 4px 10px;
                border-radius: 999px;
                background: var(--brand-accent-gold);
                color: var(--brand-primary);
                font-size: .72rem;
                text-transform: uppercase;
                font-weight: 800;
                letter-spacing: .5px;
            }

            .mh-desc {
                margin: 14px 0 0;
                color: var(--ink-600);
                line-height: 1.55;
                max-width: 650px;
            }

            .mh-right {
                min-width: 240px;
                border-radius: 12px;
                padding: 12px 16px;
                background: color-mix(in srgb, var(--accent) 8%, white);
                border: 1px solid color-mix(in srgb, var(--accent) 25%, white);
            }

            .mh-status {
                display: inline-block;
                padding: 4px 12px;
                border-radius: 999px;
                background: var(--accent);
                color: white;
                font-size: .78rem;
                font-weight: 700;
                margin-bottom: 10px;
            }

            .mh-points {
                margin: 0;
                padding-left: 18px;
                color: var(--ink-600);
                line-height: 1.8;
            }

            .kpi-row {
                display: grid;
                grid-template-columns: repeat(3, minmax(0, 1fr));
                gap: 14px;
            }

            .kpi-card {
                background: white;
                border-left: 4px solid var(--accent);
                border-radius: 12px;
                padding: 18px 20px;
                box-shadow: 0 2px 10px rgba(0,0,0,.07);
            }

            .kpi-value {
                font-size: 1.6rem;
                font-weight: 800;
                color: var(--accent);
            }

            .kpi-label {
                margin-top: 4px;
                font-size: .76rem;
                text-transform: uppercase;
                letter-spacing: .6px;
                color: var(--ink-500);
                font-weight: 700;
            }

            .kpi-trend {
                margin-top: 5px;
                font-size: .84rem;
                color: var(--ink-600);
            }

            .subview-tabs {
                display: flex;
                gap: 8px;
                flex-wrap: wrap;
                padding: 8px;
                background: white;
                border: 1px solid var(--brand-border);
                border-radius: 12px;
                box-shadow: 0 2px 8px rgba(0,0,0,.05);
            }

            .sv-tab {
                border: none;
                background: transparent;
                padding: 9px 14px;
                border-radius: 8px;
                cursor: pointer;
                color: var(--ink-500);
                font-weight: 700;
            }

                .sv-tab.active {
                    background: var(--accent);
                    color: white;
                }

            .panel-grid {
                display: grid;
                grid-template-columns: minmax(0, 2fr) minmax(280px, 1fr);
                gap: 16px;
            }

            .subview-panel, .activity-feed {
                background: white;
                border-radius: 12px;
                padding: 22px 24px;
                border: 1px solid var(--brand-border);
                box-shadow: 0 2px 10px rgba(0,0,0,.06);
            }

            .sv-toolbar {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 12px;
                margin-bottom: 16px;
            }

                .sv-toolbar h2 {
                    margin: 0;
                    color: var(--brand-primary);
                    font-size: 1.08rem;
                }

            .status-note {
                color: var(--ink-600);
                font-size: .9rem;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: .9rem;
            }

                .data-table thead {
                    background: var(--brand-primary);
                }

                .data-table th {
                    text-align: left;
                    padding: 11px 14px;
                    color: rgba(255,255,255,.92);
                    font-size: .74rem;
                    text-transform: uppercase;
                    letter-spacing: .6px;
                }

                .data-table td {
                    padding: 11px 14px;
                    border-bottom: 1px solid var(--brand-border);
                }

                .data-table tr:last-child td {
                    border-bottom: none;
                }

                .data-table tr:hover td {
                    background: var(--brand-light);
                }

            .badge {
                display: inline-block;
                padding: 4px 10px;
                border-radius: 999px;
                font-size: .76rem;
                font-weight: 700;
            }

            .badge-ok {
                background: rgba(11,61,110,.1);
                color: var(--brand-primary);
                border: 1px solid rgba(11,61,110,.2);
            }

            .badge-warn {
                background: #fff0c2;
                color: #7a4f00;
                border: 1px solid rgba(212,146,10,.3);
            }

            .badge-danger {
                background: rgba(196,30,30,.08);
                color: var(--brand-accent-red);
                border: 1px solid rgba(196,30,30,.2);
            }

            .activity-title {
                margin: 0 0 12px;
                font-size: .78rem;
                text-transform: uppercase;
                letter-spacing: .7px;
                color: var(--ink-500);
            }

            .activity-feed ul {
                margin: 0;
                padding-left: 0;
                list-style: none;
                display: flex;
                flex-direction: column;
                gap: 10px;
            }

            .activity-feed li {
                background: var(--brand-light);
                border-left: 3px solid var(--brand-accent-gold);
                padding: 10px 12px;
                border-radius: 8px;
                color: var(--ink-900);
            }

            .empty-state {
                padding: 28px 16px;
                text-align: center;
                color: var(--ink-600);
            }

            .footer-note {
                font-size: .86rem;
                color: var(--ink-600);
            }

            @@media (max-width: 1080px) {
                .panel-grid, .kpi-row {
                    grid-template-columns: 1fr;
                }

                .module-header {
                    flex-direction: column;
                }

                .mh-right {
                    min-width: 0;
                }
            }

            @@media (max-width: 820px) {
                .workspace {
                    flex-direction: column;
                }

                .sidebar {
                    width: auto;
                    flex-direction: row;
                    overflow: auto;
                    padding: 8px;
                }

                .sidebar-item {
                    white-space: nowrap;
                    border-left: none;
                    border-bottom: 3px solid transparent;
                }

                    .sidebar-item.active {
                        border-bottom-color: var(--brand-accent-gold);
                        border-left-color: transparent;
                    }

                .topbar {
                    padding: 0 14px;
                }

                .topbar-subtitle, .topbar-date {
                    display: none;
                }

                .module-view {
                    padding: 18px 14px;
                }
            }
    </style>
</head>
<body>

    <div class="page-shell">
        <header class="topbar">
            <div class="topbar-brand">
                <span>Punto Trigo</span>
                <span class="topbar-subtitle">Sistema de Gestion Comercial</span>
            </div>
            <div class="topbar-right">
                <a href="/Producto" style="color:white; text-decoration:none;">Productos</a>
                <a href="/Proveedor" style="color:white; text-decoration:none;">Proveedores</a>
                <a href="/Puesto" style="color:white; text-decoration:none;">Puestos</a>
                <a href="/Trabajador" style="color:white; text-decoration:none;">Trabajadores</a>
                <a href="/Usuario" style="color:white; text-decoration:none;">Usuarios</a>
                <span class="topbar-date">@Model.Today.ToString("dddd d 'de' MMMM yyyy", new System.Globalization.CultureInfo("es-ES"))</span>
                <span class="topbar-avatar">@Model.UserInitials</span>
            </div>
        </header>


        <div class="workspace">
            <nav class="sidebar" id="sidebar">
                @foreach (var module in Model.Modules)
                {
                    <button class="sidebar-item" data-module="@module.Key">@module.Name</button>
                }
            </nav>

            <main class="module-view">
                <section class="module-header" id="moduleHeader">
                    <div class="mh-left">
                        <h1 class="mh-title" id="moduleTitle"></h1>
                        <span class="mh-tag" id="moduleTag"></span>
                        <p class="mh-desc" id="moduleDescription"></p>
                    </div>
                    <div class="mh-right">
                        <span class="mh-status" id="moduleStatus"></span>
                        <ul class="mh-points" id="modulePoints"></ul>
                    </div>
                </section>

                <section class="kpi-row" id="kpiRow"></section>
                <nav class="subview-tabs" id="subviewTabs"></nav>

                <section class="panel-grid">
                    <div class="subview-panel">
                        <div class="sv-toolbar">
                            <h2 id="tableTitle"></h2>
                            <span class="status-note" id="tableStatus">Listo</span>
                        </div>
                        <div id="tableWrap"></div>
                    </div>
                    <aside class="activity-feed">
                        <h3 class="activity-title">Actividad reciente</h3>
                        <ul id="activityList"></ul>
                        <p class="footer-note">Información operativa actualizada desde los endpoints del sistema.</p>
                    </aside>
                </section>
            </main>
        </div>
    </div>

    <script>
            const modules = @Html.Raw(payload);
            const state = { selected: modules[0]?.key ?? null };

            const els = {
                sidebar: document.getElementById('sidebar'),
                header: document.getElementById('moduleHeader'),
                title: document.getElementById('moduleTitle'),
                tag: document.getElementById('moduleTag'),
                description: document.getElementById('moduleDescription'),
                status: document.getElementById('moduleStatus'),
                points: document.getElementById('modulePoints'),
                kpiRow: document.getElementById('kpiRow'),
                tabs: document.getElementById('subviewTabs'),
                tableTitle: document.getElementById('tableTitle'),
                tableStatus: document.getElementById('tableStatus'),
                tableWrap: document.getElementById('tableWrap'),
                activityList: document.getElementById('activityList')
            };

            function moduleByKey(key) {
                return modules.find(module => module.key === key) ?? modules[0];
            }

            function badgeClass(value) {
                const normalized = String(value).toLowerCase();
                if (['activo', 'conectado', 'online', 'migrado'].some(x => normalized.includes(x))) return 'badge badge-ok';
                if (['pendiente', 'sin', 'lectura'].some(x => normalized.includes(x))) return 'badge badge-warn';
                if (['inactivo', 'anulado', 'error'].some(x => normalized.includes(x))) return 'badge badge-danger';
                return '';
            }

            function renderTable(module, rows) {
                if (!rows.length) {
                    els.tableWrap.innerHTML = `<div class="empty-state">${module.table.emptyMessage ?? 'Sin datos.'}</div>`;
                    return;
                }

                const head = module.table.columns.map(column => `<th>${column}</th>`).join('');
                const body = rows.map(row => {
                    const cells = row.map(cell => {
                        const cls = badgeClass(cell);
                        return `<td>${cls ? `<span class="${cls}">${cell}</span>` : cell}</td>`;
                    }).join('');
                    return `<tr>${cells}</tr>`;
                }).join('');

                els.tableWrap.innerHTML = `<table class="data-table"><thead><tr>${head}</tr></thead><tbody>${body}</tbody></table>`;
            }

            function mapApiRows(module, data) {
                switch (module.key) {
                    case 'productos':
                        return data.map(item => [item.nombre_Producto ?? '-', `L ${item.precio_Venta ?? 0}`, String(item.stock_Actual ?? 0), item.estado === 1 ? 'Activo' : 'Inactivo']);
                    case 'proveedores':
                        return data.map(item => [item.nombre_Proveedor ?? '-', item.telefono_Proveedor ?? '-', item.correo_Proveedor ?? '-', item.estado === 1 ? 'Activo' : 'Inactivo']);
                    case 'usuarios':
                        return data.map(item => [item.nombre_Usuario ?? '-', item.id_Trabajador ?? '-', item.id_Estado === 1 ? 'Activo' : 'Inactivo']);
                    case 'planilla':
                        return data.map(item => [item.cedula ?? '-', item.nombre_Completo ?? '-', item.id_Puesto ?? '-', item.id_Estado === 1 ? 'Activo' : 'Inactivo']);
                    case 'puestos':
                        return data.map(item => [item.nombre_Puesto ?? '-', item.id_Puesto ?? '-', item.id_Estado === 1 ? 'Activo' : 'Inactivo']);
                    default:
                        return module.table.rows ?? [];
                }
            }

            async function fillTable(module) {
                els.tableTitle.textContent = module.table.title;

                if (!module.table.sourceUrl) {
                    els.tableStatus.textContent = 'Contenido local';
                    renderTable(module, module.table.rows ?? []);
                    return;
                }

                els.tableStatus.textContent = 'Consultando API...';

                try {
                    const response = await fetch(module.table.sourceUrl);
                    if (response.status === 204) {
                        els.tableStatus.textContent = 'API conectada';
                        renderTable(module, []);
                        return;
                    }
                    if (!response.ok) {
                        throw new Error(`HTTP ${response.status}`);
                    }
                    const data = await response.json();
                    const rows = mapApiRows(module, data);
                    els.tableStatus.textContent = 'API conectada';
                    renderTable(module, rows);
                } catch (error) {
                    els.tableStatus.textContent = 'Mostrando respaldo';
                    renderTable(module, module.table.rows ?? []);
                }
            }

            async function renderModule(key) {
                const module = moduleByKey(key);
                state.selected = module.key;
                document.querySelectorAll('.sidebar-item').forEach(button => {
                    button.classList.toggle('active', button.dataset.module === module.key);
                });

                els.header.style.setProperty('--accent', module.accent);
                els.title.textContent = module.name;
                els.tag.textContent = module.tag;
                els.description.textContent = module.description;
                els.status.textContent = module.status;
                els.status.style.background = module.accent;

                els.points.innerHTML = module.points.map(point => `<li>${point}</li>`).join('');
                els.kpiRow.innerHTML = module.metrics.map(metric => `
                    <article class="kpi-card" style="--accent:${module.accent}">
                        <div class="kpi-value">${metric.value}</div>
                        <div class="kpi-label">${metric.label}</div>
                        <div class="kpi-trend">${metric.trend}</div>
                    </article>`).join('');
                els.tabs.innerHTML = module.subViews.map((subView, index) => `
                    <button class="sv-tab ${index === 0 ? 'active' : ''}" style="--accent:${module.accent}">${subView.label}</button>`).join('');
                els.activityList.innerHTML = module.activity.map(item => `<li>${item}</li>`).join('');

                await fillTable(module);
            }

            els.sidebar.addEventListener('click', event => {
                const button = event.target.closest('[data-module]');
                if (!button) return;
                renderModule(button.dataset.module);
            });

            renderModule(state.selected);
    </script>
</body>
</html>