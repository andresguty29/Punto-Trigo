@using System.Text.Json
@model Web.Models.DashboardViewModel
@{
    Layout = null;
    var payload = JsonSerializer.Serialize(new
    {
        modules = Model.Modules,
        role = Model.CurrentRole,
        idTrabajador = Model.IdTrabajador
    }, new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    });
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Punto Trigo</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/css/dashboard.css" />
</head>
<body>

    <div class="page-shell">
        <header class="topbar">
            <div class="topbar-left">
                <button type="button" class="topbar-menu-btn" id="sidebarToggle" title="Mostrar u ocultar menu">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <line x1="3" y1="12" x2="21" y2="12"></line>
                        <line x1="3" y1="18" x2="21" y2="18"></line>
                    </svg>
                </button>

                <div class="topbar-brand">
                    <span>Punto Trigo</span>
                    <span class="topbar-subtitle">Sistema de Gestión Comercial</span>
                </div>
            </div>
            <div class="topbar-right">
                <span class="topbar-date">@Model.Today.ToString("dddd d 'de' MMMM yyyy", new System.Globalization.CultureInfo("es-ES"))</span>

                <div class="notif-wrapper" id="notifWrapper">
                    <button class="notif-bell" id="notifBell" title="Notificaciones">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                            <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                        </svg>
                        <span class="notif-badge" id="notifBadge" hidden>0</span>
                    </button>

                    <div class="notif-dropdown" id="notifDropdown">
                        <div class="notif-dropdown-header">
                            <span>Notificaciones</span>
                            <button class="notif-clear-all" id="notifClearAll">Limpiar</button>
                        </div>
                        <ul class="notif-list" id="notifList">
                            <li class="notif-empty">Sin notificaciones</li>
                        </ul>
                    </div>
                </div>

                <div class="avatar-wrapper" id="avatarWrapper">
                    <button class="topbar-avatar" id="avatarBtn">@Model.UserInitials</button>

                    <div class="avatar-dropdown" id="avatarDropdown">
                        <div class="avatar-dropdown-name">@User.Identity?.Name</div>
                        <hr class="avatar-dropdown-divider" />
                        <button class="avatar-dropdown-item" onclick="openModal('Cambiar contraseña', '/Login/CambiarContrasena?modal=true')">
                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                            Cambiar contraseña
                        </button>
                        <form asp-controller="Login" asp-action="Salir" method="post" style="margin:0;">
                            <button type="submit" class="avatar-dropdown-item avatar-dropdown-item--danger">
                                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                                Cerrar sesión
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </header>

        <div class="workspace">
            <nav class="sidebar" id="sidebar">
                <div class="sidebar-head">
                    <span class="sidebar-title">Modulos</span>
                </div>

                @foreach (var module in Model.Modules)
                {
                    <button class="sidebar-item" data-module="@module.Key">@module.Name</button>
                }
            </nav>

            <main class="module-view">
                <section class="module-header" id="moduleHeader">
                    <h1 class="mh-title" id="moduleTitle"></h1>
                    <span class="mh-tag" id="moduleTag"></span>
                    <p class="mh-desc" id="moduleDescription"></p>
                </section>

                <section class="subview-panel">
                    <div class="sv-toolbar">
                        <div>
                            <h2 id="tableTitle"></h2>
                            <span class="status-note" id="tableStatus">Listo</span>
                        </div>
                        <button id="createButton" type="button" class="btn-create">Agregar</button>
                    </div>
                    <div id="tableWrap"></div>
                </section>
            </main>
        </div>

        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
    </div>

    <div class="modal-overlay" id="crudModal">
        <div class="modal-box">
            <div class="modal-header-custom">
                <h3 id="crudModalTitle">Agregar</h3>
                <button type="button" id="closeCrudModal" class="modal-close">×</button>
            </div>
            <iframe id="crudModalFrame" class="modal-frame"></iframe>
        </div>
    </div>

    <button type="button" id="cartFloatButton" class="cart-float-btn" style="display:none;">
        🛒 <span id="cartFloatCount">0</span> — <span id="cartFloatTotal">₡0</span>
    </button>

    <div class="modal-overlay" id="cartModal">
        <div class="modal-box cart-modal-box">
            <div class="modal-header-custom">
                <h3>Carrito de venta</h3>
                <button type="button" id="closeCartModal" class="modal-close">×</button>
            </div>
            <div class="cart-modal-body">
                <div id="cartItemsList"></div>

                <div class="cart-total-row">
                    <span>Total</span>
                    <strong id="cartTotalMonto">₡0</strong>
                </div>

                <div class="mf-group">
                    <label class="mf-label">Cédula del cliente <span style="font-weight:400;text-transform:none;">(opcional — vacío = Receptor Genérico)</span></label>
                    <div style="display:flex; gap:8px;">
                        <input type="text" id="cartCedulaInput" class="mf-input" placeholder="Cédula" />
                        <button type="button" id="cartBuscarClienteBtn" class="mf-btn mf-btn-secondary">Buscar</button>
                    </div>
                    <div id="cartClienteResultado" style="margin-top:6px; font-size:0.85rem;"></div>
                </div>

                <label style="display:flex; align-items:center; gap:8px; font-size:0.85rem; color:var(--pt-ink-soft); margin-top:8px;">
                    <input type="checkbox" id="cartSimularFallo" />
                    Simular fallo de Hacienda (solo para pruebas)
                </label>

                <div id="cartErrorBanner" class="mf-error-banner" style="display:none;"></div>
                <div id="cartResultadoBox" style="display:none;"></div>
            </div>
            <div class="cart-modal-footer">
                <button type="button" id="cartVaciarBtn" class="mf-btn mf-btn-secondary">Vaciar carrito</button>
                <button type="button" id="cartConfirmarBtn" class="mf-btn mf-btn-primary">Confirmar cobro</button>
            </div>
        </div>
    </div>

    <div id="toast" class="toast" role="alert" aria-live="polite"></div>

    <div class="confirm-overlay" id="confirmOverlay">
        <div class="confirm-box">
            <p class="confirm-msg" id="confirmMsg"></p>
            <div class="confirm-actions">
                <button class="mf-btn mf-btn-danger" id="confirmOk">Sí, eliminar</button>
                <button class="mf-btn mf-btn-secondary" id="confirmCancel">Cancelar</button>
            </div>
        </div>
    </div>

    <script id="dashboard-data" type="application/json">
        @Html.Raw(payload)
    </script>
    <script src="~/js/dashboard.js"></script>
</body>
</html>
