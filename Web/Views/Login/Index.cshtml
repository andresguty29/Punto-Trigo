@model Abstracciones.Modelos.Usuario.Usuario.LoginRequest

@{
    Layout = null;
    ViewData["Title"] = "Iniciar sesión";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Punto Trigo — Iniciar sesión</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/css/login.css" />
</head>
<body>

    <div class="login-shell">

        <div class="login-brand">
            <img src="~/favicon.ico" alt="Punto Trigo" class="login-logo" />
            <h1 class="login-title">Punto Trigo</h1>
            <p class="login-subtitle">Sistema de Gestión Comercial</p>
        </div>

        <div class="login-card">
            <h2 class="login-card-title">Iniciar sesión</h2>

            @if (ViewBag.Error != null)
            {
                <div class="login-error">@ViewBag.Error</div>
            }

            <form asp-action="Index" asp-controller="Login" method="post" class="login-form">

                <div class="lf-group">
                    <label asp-for="Nombre_Usuario" class="lf-label">Usuario</label>
                    <input asp-for="Nombre_Usuario" class="lf-input" placeholder="Ingresa tu usuario" autocomplete="username" required />
                </div>

                <div class="lf-group">
                    <label asp-for="Contrasena" class="lf-label">Contraseña</label>
                    <div class="lf-input-wrap">
                        <input asp-for="Contrasena" class="lf-input" type="password" placeholder="Ingresa tu contraseña" autocomplete="current-password" required id="inputContrasena" />
                        <button type="button" class="lf-toggle-pass" id="togglePass" title="Mostrar contraseña">
                            <svg id="iconShow" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                            </svg>
                            <svg id="iconHide" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" hidden>
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/>
                            </svg>
                        </button>
                    </div>
                </div>

                <button type="submit" class="lf-btn">Ingresar</button>

            </form>
        </div>

    </div>

    <script>
        const toggle = document.getElementById('togglePass');
        const input  = document.getElementById('inputContrasena');
        const show   = document.getElementById('iconShow');
        const hide   = document.getElementById('iconHide');

        toggle.addEventListener('click', () => {
            const visible = input.type === 'text';
            input.type = visible ? 'password' : 'text';
            show.hidden = !visible;
            hide.hidden = visible;
        });
    </script>

</body>
</html>
